[Unit]
Description=Pi dashboard telemetry and bounded local history
After=NetworkManager.service piwifi-web.service

[Service]
User=thinh
Group=thinh
WorkingDirectory=/opt/piwifi-web
StateDirectory=piwifi-observer
StateDirectoryMode=0700
RuntimeDirectory=piwifi-observer
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/piwifi-web/observer.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ProtectHome=true
# Keep home protection; expose the existing user's runtime IPC through a read-only alias.
BindReadOnlyPaths=-/run/user/1000:/run/piwifi-camera-runtime
Environment=PIWIFI_CAMERA_RUNTIME=/run/piwifi-camera-runtime

[Install]
WantedBy=multi-user.target
